# EightyTwenty mobile — environment configuration
# Copy to `.env` and restart `npx expo start` after changes (add `--clear` if values don't change).
#
# IMPORTANT: every EXPO_PUBLIC_* value is compiled into the app bundle and can be read
# by anyone who installs the app. Never put API secrets, payment keys or signing
# certificates here — those belong on the backend.

# Where data comes from:
#   api  — the BOS backend in this repo (backend/, /api/v1/app). Default for this repo.
#   mock — local simulated backend. Runs fully offline, no server needed.
EXPO_PUBLIC_DATA_SOURCE=api

# Customer API base URL, no trailing slash.
#   Dev (default): the backend on this computer, http://127.0.0.1:8000/api/v1/app.
#     On a phone (Expo Go) the app swaps 127.0.0.1 for this computer's LAN IP by itself, so the
#     backend must listen on the network: `manage.py runserver 0.0.0.0:8000` (same Wi-Fi).
#   Production (Render): https://eightytwenty-api.onrender.com/api/v1/app
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1/app

# Request timeout for the HTTP client, in milliseconds (60 s covers a Render cold start).
EXPO_PUBLIC_API_TIMEOUT_MS=60000

# Customer website: Privacy & security → Privacy policy (/privacy) and Terms of use (/terms).
EXPO_PUBLIC_WEBSITE_URL=https://eightytwenty.pages.dev

# --- Mock backend only ------------------------------------------------------------
# Simulated network latency per request, in milliseconds (0 for instant).
EXPO_PUBLIC_MOCK_LATENCY_MS=350

# Keep simulated data (orders, bookings, profile edits…) across app restarts.
# Set to false for a clean demo on every launch.
EXPO_PUBLIC_MOCK_PERSIST=true

# Live order outcome in the mock: normal | declined
# "declined" shows the "We couldn't take this one" status screen.
EXPO_PUBLIC_MOCK_ORDER_OUTCOME=normal
