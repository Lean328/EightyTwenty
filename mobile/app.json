{
  "expo": {
    "name": "EightyTwenty",
    "slug": "eightytwenty",
    "owner": "my-an-lien",
    "scheme": "eightytwenty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F0E8",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "au.com.eightytwentyfood.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "au.com.eightytwentyfood.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8",
        "foregroundImage": "./assets/branding/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAEDDD",
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#4B2E26",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock EightyTwenty with Face ID instead of your password."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0f070f7f-257e-42ba-ab68-86acae15bcdb"
      }
    }
  }
}
