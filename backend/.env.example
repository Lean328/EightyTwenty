# Local: copy to backend/.env. Never commit real credentials.
SECRET_KEY=development-only-change-before-deploy-8t20
DEBUG=True
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Leave DATABASE_URL unset to use SQLite locally (backend/db.sqlite3; fill it with
# seed_from_mock + seed_demo, see README). pytest ignores remote databases. Production MUST
# use Postgres. `migrate` prefers DATABASE_URL_MIGRATIONS when set: set both or neither.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# DATABASE_URL_MIGRATIONS=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
SUPABASE_PUBLIC_MEDIA_BASE=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Brevo (key xkeysib-…) or Resend; EMAIL_PROVIDER=brevo|resend, or guessed from the key.
# The sender's domain must be verified with the provider. Dev without a key prints to the console.
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
# Dev with a real key: send every email here instead of the cafés' real inboxes. Empty on Render.
EMAIL_REDIRECT_TO=
EMAIL_FROM=EightyTwenty <no-reply@eightytwentyfood.com.au>
CLIENT_BASE_URL=http://localhost:5173
# Admin image previews for website-relative paths (img/...). Defaults to CLIENT_BASE_URL; dev uses http://127.0.0.1:8123.
# MEDIA_PREVIEW_BASE_URL=

# Mandatory in production. Use exact website hostnames, without scheme/path.
TURNSTILE_ENABLED=False
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
JOB_TOKEN=
DOCS_ENABLED=True
# 0: use REMOTE_ADDR; set after verifying the deployed reverse-proxy chain.
TRUSTED_PROXY_COUNT=0
# Expo push for the customer app (no key needed; access token only with enhanced security).
PUSH_ENABLED=True
EXPO_ACCESS_TOKEN=
# App payments: "" = 501 (no card payments), demo = test tokens, no money moves,
# square = Square Payments API (docs/SQUARE_SETUP.md). The access token is a secret.
PAYMENT_PROVIDER=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
# Reserved; no Sentry integration is enabled by this code.
SENTRY_DSN=
