{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "127.0.0.1:8000",
        "--noreload"
      ],
      "port": 8000
    },
    {
      "name": "website",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123",
        "--bind",
        "127.0.0.1",
        "--directory",
        "website"
      ],
      "port": 8123
    },
    {
      "name": "backend-demo-payments",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "127.0.0.1:8010",
        "--noreload"
      ],
      "env": {
        "PAYMENT_PROVIDER": "demo"
      },
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "mobile/node_modules/expo/bin/cli",
        "start",
        "mobile",
        "--web",
        "--port",
        "8083"
      ],
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "api",
        "EXPO_PUBLIC_API_BASE_URL": "http://127.0.0.1:8010/api/v1/app",
        "TEMP": "mobile/.expo/tmp-web-api",
        "TMP": "mobile/.expo/tmp-web-api"
      },
      "port": 8083,
      "autoPort": false
    },
    {
      "name": "mobile-web-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "mobile/node_modules/expo/bin/cli",
        "start",
        "mobile",
        "--web",
        "--port",
        "8084"
      ],
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "mock",
        "EXPO_PUBLIC_MOCK_LATENCY_MS": "0",
        "TEMP": "mobile/.expo/tmp-web-mock",
        "TMP": "mobile/.expo/tmp-web-mock"
      },
      "port": 8084,
      "autoPort": false
    }
  ]
}
